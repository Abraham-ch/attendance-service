DATABASE_URL=postgres://postgres:password@localhost:5432/attendance_service
API_URL=127.0.0.1:3000
ALLOWED_ORIGIN=http://localhost:5173
SECRET_KEY=your-jwt-secret

SQLX_OFFLINE=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587 #STARTTLS
SMTP_USERNAME=test@mail.com
SMTP_NAME=Test
APP_PASSWORD=your-app-generated-password

# Avatars: a public Supabase Storage bucket, the service role key never leaves the API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_AVATAR_BUCKET=avatars

# Optional: how far (metres) from the daily QR a student may check in, default 150
CHECK_IN_RADIUS_METERS=150
