{
  "tab_size": 2,
  "format_on_save": "on",
  "languages": {
    "Rust": {
      "tab_size": 4,
      // rustfmt straight from stdin, so saving formats even while rust-analyzer is loading or down
      "formatter": {
        "external": { "command": "rustfmt", "arguments": ["--edition", "2024"] },
      },
    },
    "TypeScript": {
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
    },
    "TSX": {
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
    },
    "JavaScript": {
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
    },
    "CSS": {
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
    },
  },
  "lsp": {
    "oxfmt": {
      // oxfmt lives in web/, not at the worktree root where the extension looks
      "binary": {
        "path": "node",
        "arguments": ["web/node_modules/oxfmt/bin/oxfmt", "--lsp"],
      },
    },
  },
}
