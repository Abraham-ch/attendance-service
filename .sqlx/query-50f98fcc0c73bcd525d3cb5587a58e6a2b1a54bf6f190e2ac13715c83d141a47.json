{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    id,\n                    dni,\n                    first_name,\n                    last_name,\n                    email,\n                    gender AS \"gender:Gender\",\n                    phone,\n                    address,\n                    (\n                        SELECT u.avatar FROM users u\n                        WHERE u.student_id = students.id AND u.avatar <> ''\n                        LIMIT 1\n                    ) AS avatar,\n                    created_at,\n                    updated_at\n                FROM students\n                WHERE id = $1\n            ",
