{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    id,\n                    first_name,\n                    last_name,\n                    email,\n                    password,\n                    avatar,\n                    role AS \"role: Role\",\n                    created_at,\n                    updated_at\n                FROM users\n                WHERE $1::TEXT IS NULL\n                    OR (first_name || ' ' || last_name) ILIKE $1\n                    OR email ILIKE $1\n                ORDER BY last_name, first_name, id\n                LIMIT $2 OFFSET $3\n            ",
