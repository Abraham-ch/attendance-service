  "query": "\n            UPDATE\n                users\n                SET\n                    first_name = COALESCE($1, first_name),\n                    last_name = COALESCE($2, last_name),\n                    email = COALESCE($3, email),\n                    password = COALESCE($4, password),\n                    avatar = COALESCE($5, avatar),\n                    role = COALESCE($6, role)\n            WHERE id = $7\n            RETURNING\n                first_name,\n                last_name,\n                email,\n                password,\n                avatar,\n                role AS \"role: Role\"\n        ",
